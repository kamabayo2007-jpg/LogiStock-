# Copier ce fichier en ".env" pour changer les valeurs (le fichier .env n'est jamais envoyé sur GitHub).
# Sans .env, les valeurs par défaut de docker-compose.yml sont utilisées (suffisant pour la démo).
DB_PASSWORD=rootpass
JWT_SECRET=changez-moi-par-une-longue-phrase-secrete-de-32-caracteres-minimum
CORS_ORIGINS=http://localhost:4200,http://localhost
